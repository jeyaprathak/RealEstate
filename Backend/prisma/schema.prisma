generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {

  id          Int      @id @default(autoincrement())

  name        String

  email       String   @unique

  password    String

  role        Role     @default(USER)

  createdAt   DateTime @default(now())

  properties  Property[]

  inquiries   Inquiry[]
}

model Property {

  id             Int       @id @default(autoincrement())

  title          String

  description    String

  city           String

  location       String

  price          Float

  bedrooms       Int

  bathrooms      Int

  propertyType   String

  image          String

  featured       Boolean   @default(false)

  approved       Boolean   @default(false)

  createdAt      DateTime  @default(now())

  userId         Int

  user           User @relation(fields: [userId], references: [id])

  inquiries      Inquiry[]

  @@index([city])

  @@index([price])

  @@index([propertyType])

  @@index([approved])

  @@index([featured])
}

model Inquiry {

  id          Int      @id @default(autoincrement())

  message     String

  createdAt   DateTime @default(now())

  userId      Int

  propertyId  Int

  user        User @relation(fields: [userId], references: [id])

  property    Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId])
}